VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_TRANSLATION_MODEL=gpt-5-mini
OPENAI_LOOKUP_MODEL=gpt-5-mini
# 아래 두 값은 Vercel 백엔드 전용입니다. SUPABASE_SERVICE_ROLE_KEY는 VITE_ 접두사를 붙이지 마세요.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Supadata 대시보드의 서버용 API 키입니다. 프런트엔드(VITE_) 변수로 만들지 마세요.
SUPADATA_API_KEY=
# 아래 프록시 값은 Supadata를 사용하지 않는 로컬/대체 구성에서만 필요합니다.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
WEBSHARE_PROXY_LOCATIONS=us,kr,jp
YOUTUBE_PROXY_URL=
# 관리자 전용 토스 테스트 구독. live_ 키는 코드에서 거부합니다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Fernet 형식의 암호화 키. 빌링키가 남아 있는 동안 변경/분실하면 안 됩니다.
BILLING_ENCRYPTION_KEY=
# Supabase Vault의 turtle_worker_secret과 같은 무작위 값
INTERNAL_WORKER_SECRET=
